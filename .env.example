# DingTalk MCP URL
DINGTALK_MCP_URL=https://your-streamable-http-mcp-url

# Optional DingTalk config path override
DINGTALK_CONFIG_PATH=weekly_report_platform/resources/config.local.json

# Mail settings
EMAIL_POP3_HOST=pop3.hundsun.cn
EMAIL_POP3_PORT=995
EMAIL_USERNAME=your_email@domain.com
EMAIL_PASSWORD=your_password
EMAIL_SUBJECT_KEYWORD=周报

# LLM settings
LLM_URL=http://your-llm-endpoint/v1/chat/completions
LLM_MODEL=your-model-name
LLM_AUTHORIZATION=Bearer your_token
LLM_MAX_TOKENS=10000
LLM_TEMPERATURE=0.01
LLM_STREAM=false
LLM_N=1
